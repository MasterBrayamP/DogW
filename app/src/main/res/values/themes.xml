<resources>
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/dw_green</item>
        <item name="colorPrimaryDark">@color/dw_green_dark</item>
        <item name="colorAccent">@color/dw_green</item>
        <item name="android:statusBarColor">@color/dw_green_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/dw_bg</item>
        <item name="materialButtonStyle">@style/Widget.DogWalker.Button</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <style name="Widget.DogWalker.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/dw_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
</resources>
